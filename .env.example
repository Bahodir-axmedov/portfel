# ============================================================================
# Bahodir.dev portfolio — environment variables
# Copy to .env.local for local development, and set the same keys in Railway.
# NEVER commit the real .env file.
# ============================================================================

# --- Database -------------------------------------------------------------
# Local development (file inside the repo, git-ignored):
DATABASE_URL="file:./prisma/dev.db"
# Railway with a persistent volume mounted at /data:
# DATABASE_URL="file:/data/portfolio.db"

# --- Site -----------------------------------------------------------------
# Public site URL, used for sitemap.xml, robots.txt, OpenGraph and QR codes.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin authentication -------------------------------------------------
# Login email for /admin
ADMIN_EMAIL="Axmedovbahodir1122@gmail.com"
# bcrypt hash of your admin password. Generate it with:
#   npm run hash -- "YourStrongPassword"
ADMIN_PASSWORD_HASH=""
# Random 32+ character string used to sign the session JWT. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=""
# Session lifetime in hours (default 12)
AUTH_SESSION_HOURS="12"

# --- Uploads --------------------------------------------------------------
# Directory for uploaded images/files. On Railway point it at the volume.
UPLOAD_DIR="./public/uploads"
# UPLOAD_DIR="/data/uploads"
MAX_UPLOAD_MB="8"

# --- Images ---------------------------------------------------------------
# Extra hosts allowed by next/image, comma separated. The site's own host and
# *.up.railway.app are always allowed, so this is only needed for a CDN.
# IMAGE_ALLOWED_HOSTS="cdn.example.com,images.example.com"
IMAGE_ALLOWED_HOSTS=""

# --- Analytics (optional, add later) --------------------------------------
NEXT_PUBLIC_GA_ID=""

# --- Contact form (optional) ---------------------------------------------
# Telegram bot used to forward contact-form messages to you.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Build / tooling only -------------------------------------------------
# Set automatically by Next.js and Docker. Listed here only so every variable
# the code reads is documented in one place.
# NODE_ENV="development"
# Path to a Chromium binary, used by scripts/generate-resume.mjs when
# regenerating the PDF CVs. Not needed at runtime.
# CHROME_BIN="/usr/bin/chromium"
